    </FIELD>
    <FIELD name="ABP50" ucd="phys.absorption" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>StarHorse line-of-sight extinction in the GBP band 50th percentile derived from AV50 and teff50 (abp50)</DESCRIPTION>
    </FIELD>
    <FIELD name="ARP50" ucd="phys.absorption" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_EXTINCTION_ISM" -->
      <DESCRIPTION>StarHorse line-of-sight extinction in the GRP band 50th percentile derived from AV50 and teff50 (arp50)</DESCRIPTION>
    </FIELD>
    <FIELD name="GMAG0" ucd="phys.magAbs" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_ABS-MAG_BAND" -->
      <DESCRIPTION>StarHorse absolute magnitude derived from phot_g_mean_mag (recalibrated) dist50 and AG50 (mg0)</DESCRIPTION>
