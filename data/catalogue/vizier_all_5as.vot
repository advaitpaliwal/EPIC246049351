      <DESCRIPTION>? Integrated RP mean magnitude (Vega) (phot_rp_mean_mag) (41)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="e_RPmag" ucd="stat.error;phot.mag;stat.mean" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="ERROR" -->
      <DESCRIPTION>? Standard error of RP mean magnitude (Vega) (added by CDS) (phot_rp_mean_mag_error) (G1)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="BP-RP" ucd="phot.color;em.opt.B;em.opt.R" datatype="double" width="9" precision="6" unit="mag"><!-- ucd="PHOT_CI_B-R" -->
      <DESCRIPTION>? BP-RP colour (photBpMeanMag - photRpMeanMag) (bp_rp)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="RVDR2" ucd="spect.dopplerVeloc.opt;em.opt.I" datatype="double" width="7" precision="2" unit="km/s"><!-- ucd="VELOC_BARYCENTER" -->
      <DESCRIPTION>? Radial velocity from Gaia DR2 (dr2_radial_velocity) (46)</DESCRIPTION>
      <VALUES null="NaN" />
