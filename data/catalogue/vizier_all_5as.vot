  <TABLE ID="I_350_comscanl" name="I/350/comscanl">
    <DESCRIPTION>*Representation of the Gaia scanning law over the 34 month time period covered by the Gaia Data Release 3</DESCRIPTION>
<!-- *Representation of the Gaia scanning law over the 34 month time period covered by the Gaia Data Release 3 (\originalcolumnnames) -->

    <!-- Definitions of GROUPs and FIELDs -->

<!-- +++No column could be found to attach a LINK in table: I/350/comscanl -->
    <FIELD name="_r" ucd="pos.angDistance" datatype="double" width="5" precision="3"><!-- ucd="POS_ANG_DIST_GENERAL" -->
      <DESCRIPTION>Distance from center (351.49778000000 -8.27045000000)[ICRS]</DESCRIPTION>
    </FIELD>
    <FIELD name="JD" ucd="time.epoch" ref="time_10" datatype="double" width="18" precision="13" unit="d"><!-- ucd="TIME_EPOCH" -->
      <DESCRIPTION>[1666.42/2704.38] Julian date in TCB at Gaia (JD-2455197.5) (jd_time) (1)</DESCRIPTION>
    </FIELD>
    <FIELD name="BJD-FOV1" ucd="time.epoch" ref="time_11" datatype="double" width="18" precision="13" unit="d"><!-- ucd="TIME_EPOCH" -->
      <DESCRIPTION>[1666.42/2704.38] Observation time for FOV1 Barycentric JD (in TCB) (BJD-2455197.5) (bjd_fov1) (2)</DESCRIPTION>
    </FIELD>
    <FIELD name="BJD-FOV2" ucd="time.epoch" ref="time_11" datatype="double" width="18" precision="13" unit="d"><!-- ucd="TIME_EPOCH" -->
      <DESCRIPTION>[1666.42/2704.38] Observation time for FOV2 Barycentric JD (in TCB) (BJD-2455197.5) (bjd_fov2) (3)</DESCRIPTION>
    </FIELD>
    <FIELD name="OBMT" ucd="time.epoch" datatype="long" width="18"><!-- ucd="TIME_EPOCH" -->
      <DESCRIPTION>Observation time at Gaia converted to OBMT using the HATT (High Accuracy Time Transformation) (obmt_time)</DESCRIPTION>
    </FIELD>
    <FIELD name="RA1" ucd="pos.eq.ra;meta.main" ref="H" datatype="double" width="15" precision="11" unit="deg"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>FOV1 barycentric right ascension in ICRS at given time BJD-FOV1 (ra_fov1)</DESCRIPTION>
    </FIELD>
    <FIELD name="DE1" ucd="pos.eq.dec;meta.main" ref="H" datatype="double" width="15" precision="11" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>FOV1 barycentric declination in ICRS at given time BJD-FOV1 (dec_fov1)</DESCRIPTION>
