  <TABLE ID="II_313_table3" name="II/313/table3">
    <DESCRIPTION>PTF photometric catalog 1.0</DESCRIPTION>
<!-- PTF photometric catalog 1.0 {\em(limited to not strongly variable sources with reliable photometry; i.e. Flag=1)} -->

    <!-- Definitions of GROUPs and FIELDs -->

<!-- +++No column could be found to attach a LINK in table: II/313/table3 -->
    <FIELD name="_r" ucd="pos.angDistance" datatype="double" width="5" precision="3"><!-- ucd="POS_ANG_DIST_GENERAL" -->
      <DESCRIPTION>Distance from center (351.497780-08.270450)[FK5/J2000]</DESCRIPTION>
    </FIELD>
    <FIELD name="RAJ2000" ucd="pos.eq.ra;meta.main" ref="J2000" datatype="double" width="10" precision="6" unit="deg"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>Median J2000.0 right ascension over all the images used to derive the photometry</DESCRIPTION>
    </FIELD>
    <FIELD name="DEJ2000" ucd="pos.eq.dec;meta.main" ref="J2000" datatype="double" width="10" precision="6" unit="deg"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Median J2000.0 declination over all the images used to derive the photometry</DESCRIPTION>
    </FIELD>
    <FIELD name="Nobs" ucd="meta.number" datatype="short" width="3"><!-- ucd="NUMBER" -->
      <DESCRIPTION>[3/30] Number of images that were used to derive the photometry</DESCRIPTION>
    </FIELD>
