      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="FG" ucd="phot.flux;em.opt" datatype="float" width="11" precision="E4"><!-- ucd="PHOT_FLUX_OPTICAL" -->
      <DESCRIPTION>? Mean flux in the G-band (phot_g_mean_flux)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="e_FG" ucd="stat.error;phot.flux;em.opt" datatype="float" width="11" precision="E4"><!-- ucd="ERROR" -->
      <DESCRIPTION>? Standard deviation of the G-band fluxes divided by sqrt(photGNObs) (phot_g_mean_flux_error)</DESCRIPTION>
